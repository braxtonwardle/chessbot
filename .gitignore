# WhatsApp session credentials -- equivalent to being logged into the
# account. Never commit this, even to a private repo.
session/

# Node dependencies -- reinstalled via `npm install`, shouldn't be tracked.
node_modules/

# Python bytecode cache
__pycache__/
*.pyc

# Images downloaded/generated at runtime (chessbot.mjs cleans these up
# automatically now, but ignore them in case any linger)
received_*.jpeg
received_*.jpg
received_*.png
*_cropped.*
*_nearmiss.*

# Old whatsapp-web.js checkout and its session/cache data, no longer used
whatsapp-web.js-main/
.wwebjs_auth/
.wwebjs_cache/

# Generated training data for models/chess_piece_classifier.pt -- several
# GB, regenerated by re-running training/*.py in order (see CONTEXT.md).
# The finished model itself (models/chess_piece_classifier.pt) IS tracked.
training/piece_svgs/
training/piece_pngs/
training/synthetic_boards/
training/tiles/
training/model_epoch*.pt
training/model_finetuned.pt
training/*.txt

# Puzzle round state (names + in-progress answers) -- runtime data, not code.
puzzle_state.json

# Editor/OS clutter
.vscode/
Thumbs.db
.DS_Store
